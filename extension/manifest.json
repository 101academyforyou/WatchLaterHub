{
  "manifest_version": 3,
  "name": "WatchLaterHub",
  "version": "4.2.0",
  "description": "新分頁：隨機顯示一部你在 YouTube 收藏的影片 + Google 搜尋 + 書籤",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "identity",
    "alarms",
    "bookmarks",
    "favicon",
    "history",
    "geolocation",
    "nativeMessaging",
    "cookies",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}